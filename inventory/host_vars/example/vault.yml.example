# ==============================================================================
# Per-host secrets schema (inventory/host_vars/example/vault.yml.example)
# ==============================================================================
# make host-init copies this schema into host_vars/<hostname>/vault.yml and
# encrypts it; edit it with `make vault-edit HOST=<hostname>`. The real file is
# gitignored and NEVER committed (even encrypted). It is the single per-host
# vault: user-supplied values, control-generated values passed TO the host, and
# secrets returned BY the host. The vault password lives outside the repo
# (ansible.cfg; `make vault-init` creates it).
# ==============================================================================

# --- SSH connection identity -------------------------------------------------
# host-bootstrap probes [ansible, admin, root] and connects as the first that
# works. Each identity may set a password and/or a private key file (SSH prefers
# the key). vault_*_ssh_pubkey_file is an optional control-node path to the
# matching public key; when set it is authorized for that account (empty is
# ignored; keys are never generated). Only paths, never raw key strings.
vault_host_root_password: ""
vault_host_root_ssh_privkey_file: "~/.ssh/id_ed25519"
vault_host_root_ssh_pubkey_file: ""
# The optional human 'admin' operator account is created only when
# host_admin_enabled is true in main.yml; it always gets a password (generated
# here when left empty) plus any configured key.
vault_host_admin_user: "admin"
vault_host_admin_password: ""
vault_host_admin_ssh_privkey_file: ""
vault_host_admin_ssh_pubkey_file: ""
# The `ansible` service account uses key auth when its public key is set,
# otherwise a password (host_bootstrap_password, else generated here).
vault_host_ansible_user: "ansible"
vault_host_ansible_password: ""
vault_host_ansible_ssh_privkey_file: "~/.ssh/id_ed25519_ansible"
vault_host_ansible_ssh_pubkey_file: ""

# --- Public endpoint ---------------------------------------------------------
# Email used for Let's Encrypt certificate issuance.
vault_letsencrypt_email: "admin@example.com"

# --- Optional first-owner bootstrap ------------------------------------------
# Set the email to auto-create the first owner via /api/setup (and provision the
# tenant token below); leave it empty to onboard manually at
# https://<domain>/setup. The password is optional (empty => generated here) and
# is ignored without an email.
vault_owner_email: ""
vault_owner_name: ""
vault_owner_password: ""

# --- Tenant config-as-code access token --------------------------------------
# vault_admin_service_user_access_token is host-returned; it is written below,
# not set here.

# ==============================================================================
# Secrets managed automatically (do not set these by hand)
# ==============================================================================
# Returned BY the NetBird host (fill-if-empty; never rotated):
#   vault_admin_service_user_access_token   'admin' service-user PAT (expires;
#                                           recreate it from the Dashboard)
#   vault_setup_key_<name>                  per new setup key (returned only at
#                                           creation; non-alphanumerics become '_')
# Generated by the control node when left empty and passed TO the host:
#   vault_datastore_encryption_key          data-at-rest key. KEEP AND BACK IT UP:
#                                           it is NOT in the backup archive and a
#                                           restore MUST reuse the same value, or
#                                           the encrypted user data is lost.
#   vault_session_cookie_encryption_key     session cookie key (auto-generated
#                                           internal; leave unedited)
#   vault_relay_auth_secret                 relay auth secret (auto-generated
#                                           internal; leave unedited)
#   vault_owner_password                    first owner password
#   vault_host_ansible_password             service account password (only when
#                                           no public key is given)
#   vault_host_admin_password               admin password (only when
#                                           host_admin_enabled is true)
# Back up both this file and the host data; only vault_datastore_encryption_key is
# unrecoverable if lost.
