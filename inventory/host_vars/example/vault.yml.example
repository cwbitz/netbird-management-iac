# ==============================================================================
# Per-host secrets schema (inventory/host_vars/example/vault.yml.example)
# ==============================================================================
# `make host-init` copies this schema into host_vars/<hostname>/vault.yml and
# encrypts it; edit with `make vault-edit HOST=<hostname>`. Gitignored, never
# committed. Holds operator-set values, control-generated values passed to the
# host, and host-returned secrets; the vault password lives outside the repo
# (`make vault-init`).
# ==============================================================================

# --- SSH connection identity -------------------------------------------------
# host-bootstrap probes [iac, admin, root] and connects as the first that
# works. Account names and key paths are non-secret and live in the main.yml next
# to this file (host_admin_username, host_<id>_ssh_{pub,priv}key_file); this file
# holds only the passwords. An identity becomes key-only once its public-key path
# is set there (empty is ignored; keys are never generated).
vault_host_root_password: ""
# The optional human 'admin' operator account is created only when
# create_admin_account is true in main.yml; it always gets a password (generated
# here when left empty) plus any configured key.
vault_host_admin_password: ""
# The `iac` automation account name is fixed (`iac`); it uses key auth when
# its public key is set, otherwise a password from vault_host_iac_password
# (generated here when left empty).
vault_host_iac_password: ""

# --- Optional first-owner bootstrap ------------------------------------------
# The owner email/name live in main.yml; this is only the first owner's password
# (empty => generated here, ignored while the email is empty).
vault_owner_password: ""

# ==============================================================================
# Secrets managed automatically (do not set these by hand)
# ==============================================================================
# Returned BY the NetBird host (fill-if-empty; never rotated):
#   vault_service_admin_access_token   'admin' service-user PAT (expires;
#                                           recreate it from the Dashboard)
#   vault_<setup-key-name>                  per new setup key (returned only at
#                                           creation; non-alphanumerics become '_')
# Generated by the control node when left empty and passed TO the host:
#   vault_datastore_encryption_key          data-at-rest key. KEEP AND BACK IT UP:
#                                           it is NOT in the backup archive and a
#                                           restore MUST reuse the same value, or
#                                           the encrypted user data is lost.
#   vault_session_cookie_encryption_key     session cookie key (auto-generated
#                                           internal; leave unedited)
#   vault_relay_auth_secret                 relay auth secret (auto-generated
#                                           internal; leave unedited)
#   vault_owner_password                    first owner password
#   vault_host_iac_password             service account password (only when
#                                           no public key is given)
#   vault_host_admin_password               admin password (only when
#                                           create_admin_account is true)
# Back up both this file and the host data; only vault_datastore_encryption_key is
# unrecoverable if lost.
