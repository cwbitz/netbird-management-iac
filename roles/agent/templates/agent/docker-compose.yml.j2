# ==============================================================================
# NetBird overlay agent (mesh join)
# Managed by Ansible - do not edit on the target host.
# ==============================================================================
services:
  netbird:
    image: "{{ netbird_agent_image }}:{{ netbird_agent_version }}"
    container_name: netbird
    restart: unless-stopped
    stop_grace_period: 15s
    network_mode: host
    cap_add:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
    devices:
      - /dev/net/tun
    environment:
      NB_SETUP_KEY: "{{ netbird_peer_setup_key }}"
      NB_MANAGEMENT_URL: "https://{{ domain_name }}"
      NB_HOSTNAME: "{{ inventory_hostname }}"
    volumes:
      - netbird_config:/var/lib/netbird
      # The agent manages the host's DNS: it talks to systemd-resolved over
      # D-Bus where present, and otherwise rewrites /etc/resolv.conf (file mode).
      # Either way it serves the netbird zone (`<peer>.netbird.selfhosted`) on
      # the host and inside containers that forward to it (e.g. a central
      # Prometheus), so both host paths are mounted — DNS is not optional.
      - /var/run/dbus:/var/run/dbus
      - /etc/resolv.conf:/etc/resolv.conf

volumes:
  netbird_config:
    name: netbird_config
