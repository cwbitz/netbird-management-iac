# ==============================================================================
# Optional monitoring Docker services (netbird overlay peer + Alloy log shipper)
# Managed by Ansible - do not edit on the target host.
# ==============================================================================
services:
{% if host_monitoring_netbird_enabled | bool %}
  netbird:
    image: "{{ host_monitoring_netbird_image }}:{{ host_monitoring_netbird_version }}"
    container_name: netbird
    restart: unless-stopped
    stop_grace_period: 15s
    network_mode: host
    cap_add:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
    devices:
      - /dev/net/tun
    environment:
      NB_SETUP_KEY: "{{ host_monitoring_netbird_setup_key }}"
      NB_MANAGEMENT_URL: "{{ host_monitoring_netbird_management_url }}"
      NB_HOSTNAME: "{{ host_monitoring_netbird_hostname }}"
    volumes:
      - netbird_config:/var/lib/netbird
{% endif %}
{% if host_monitoring_alloy_enabled | bool %}
  alloy:
    image: "{{ host_monitoring_alloy_image }}:{{ host_monitoring_alloy_version }}"
    container_name: alloy
    restart: unless-stopped
    user: "0:0"
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - /var/log/journal:/var/log/journal:ro
      - /run/log/journal:/run/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro
{% endif %}

volumes:
  netbird_config:
    name: netbird_config
